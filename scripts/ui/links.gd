class_name Links
extends RefCounted
## 1.20: куда ведёт уведомление — окно (и раздел), где с этим разбираться. Любое уведомление кликабельно:
## если подходящего окна нет — открывается журнал событий.
static func target(text: String, fallback: String = "events:log") -> String:
	var t := text.to_lower()
	var rules: Array = [
		[["зарплат", "трудовая инспекц", "не платят"], "finance:summary"],
		[["кредит", "налог", "касс", "в долгах", "долг ", "неустойк", "банк"], "finance:summary"],
		[["грант"], "finance:grants"],
		[["страхов"], "finance:insurance"],
		[["снабжени", "металл", "расходник", "инструмент", "поставщик"], "prod:supply"],
		[["ппр", "сломал", "станок", "наладк", "переналад"], "prod:machines"],
		[["некому точить", " принят", "найм", "кандидат", "уволил", "уволен", "ушёл с завода", "ушла с завода"], "people:staff"],
		[["обучени", "курсы", "разряд"], "people:train"],
		[["травм", "охрана труда", "инструктаж", "сиз"], "people:safety"],
		[["профсоюз", "забастовк"], "events:now"],
		[["проверк", "инспектор", "пожарн", "санэпид", "штраф"], "events:insp"],
		[["контракт", "тендер"], "orders:contracts"],
		[["предложени", "сбыт", "заказ", "заказчик", "клиент", "отгруз", "просроч"], "orders:active"],
		[["техотдел", "разработк", "чертёж"], "office:research"],
		[["без мастера", "без рабочего места", "аврал", "отдел"], "office:develop"],
		[["многотиражк", "газет"], "events:paper"],
		[["гололёд", "отопител", "холодно", "мороз", "письм"], "events:now"],
		[["кот ", "кошк", "котён"], "town:cat"],
		[["этап", "цель", "рейтинг", "достижени"], "goals:stage"],
	]
	for r: Array in rules:
		for k: String in r[0]:
			if t.contains(k):
				return str(r[1])
	return fallback
