# ---------------------------------------------------------------- данные (без сцены)

static func _build_index() -> void:
	if not _index.is_empty():
		return
	for s: Dictionary in SECTIONS:
		_sec_index[str(s["id"])] = s
		for a: Dictionary in s["arts"]:
			if hidden_art(str(a["id"])):
				continue
			var d: Dictionary = a.duplicate()
			d["see"] = (a.get("see", []) as Array).filter(func(l: String) -> bool: return not hidden_art(l))
			d["sec"] = str(s["id"])
			d["plain"] = _norm(str(a["title"]) + " " + plain_text(str(a["text"])))
			_index[str(a["id"])] = d
			_order.append(str(a["id"]))


## 1.40: статьи о механиках, что сейчас выключены (главный инженер — Defs.CHIEF_ENGINEER).
static func hidden_art(id: String) -> bool:
	return id == "advisor" and not Defs.CHIEF_ENGINEER


## 1.40: заголовки и тексты на языке игры — по ключам help.<id>.title / help.<id>.text / help.sec.<id>.
static func title_of(id: String) -> String:
	_build_index()
	return L.dt("help.%s.title" % id, str(_index.get(id, {}).get("title", "")))


static func text_of(id: String) -> String:
	_build_index()
	return L.dt("help.%s.text" % id, str(_index.get(id, {}).get("text", "")))


static func sec_title(sid: String) -> String:
	_build_index()
	return L.dt("help.sec.%s" % sid, str(_sec_index.get(sid, {}).get("title", "")))


## Текст для поиска на языке игры (русский — заранее посчитан в индексе).
static func _plain_of(id: String) -> String:
	var a: Dictionary = _index[id]
	if not L.is_en():
		return str(a["plain"])
	if not a.has("plain_en"):
		a["plain_en"] = _norm(title_of(id) + " " + plain_text(text_of(id)))
	return str(a["plain_en"])


static func section_count() -> int:
	return SECTIONS.size()


static func article_count() -> int:
	_build_index()
	return _order.size()


static func article_ids() -> Array[String]:
	_build_index()
	return _order.duplicate()


static func article(id: String) -> Dictionary:
	_build_index()
	return _index.get(id, {})


static func section(id: String) -> Dictionary:
	_build_index()
	return _sec_index.get(id, {})


static func plain_text(bb: String) -> String:
	var re := RegEx.create_from_string("\\[[^\\]]*\\]")
	return re.sub(bb, "", true)


static func _norm(s: String) -> String:
	return s.to_lower().replace("ё", "е")


## Статьи по запросу: сначала совпадения в заголовке, потом в тексте.
static func search(q: String) -> Array[String]:
	_build_index()
	var nq := _norm(q.strip_edges())
	var res: Array[String] = []
	if nq == "":
		return res
	var tail: Array[String] = []
	for id in _order:
		if _norm(title_of(id)).contains(nq):
			res.append(id)
		elif _plain_of(id).contains(nq):
			tail.append(id)
	res.append_array(tail)
	return res


## Ссылки «См. также» и [url=…] в тексте, которые никуда не ведут (для теста).
static func broken_links() -> Array[String]:
	_build_index()
	var bad: Array[String] = []
	var re := RegEx.create_from_string("\\[url=([a-z0-9_]+)\\]")
	for id in _order:
		var a: Dictionary = _index[id]
		for l: String in a.get("see", []):
			if not _index.has(l) or l == id:
				bad.append("%s → %s" % [id, l])
		for m: RegExMatch in re.search_all(str(a["text"])):
			if not _index.has(m.get_string(1)):
				bad.append("%s → %s" % [id, m.get_string(1)])
	return bad


static func icon_of(spec: String) -> Texture2D:
	if spec.begins_with("obj:"):
		return Tex.obj(spec.substr(4))
	if spec.begins_with("item:"):
		return Tex.item(spec.substr(5))
	if spec.begins_with("ui:"):
		return Tex.ui(spec.substr(3))
	return null


