func _unhandled_key_input(e: InputEvent) -> void:
	var k := e as InputEventKey
	if k and k.pressed and not k.echo and (k.keycode == KEY_ESCAPE or k.keycode == KEY_F1):
		get_viewport().set_input_as_handled()
		_close()


func _close() -> void:
	if on_close.is_valid():
		on_close.call()
	else:
		queue_free()


## Открыть статью: текст справа, подсветка слева, «См. также».
func open(id: String) -> void:
	if not _index.has(id):
		return
	cur = id
	last_id = id
	var a: Dictionary = _index[id]
	var sec: Dictionary = _sec_index[str(a["sec"])]
	if open_sec != str(a["sec"]):
		open_sec = str(a["sec"])
		if _search.text.strip_edges() == "":
			_fill_list()
	_crumb.text = sec_title(str(sec["id"])).to_upper()
	_title.text = title_of(id)
	var tex := icon_of(str(a.get("icon", "")))
	if tex == null:
		tex = Tex.ui(str(sec["icon"]))
	_icon.texture = tex
	_text.text = text_of(id)
	_text.scroll_to_line(0)
	UITheme.clear(_see_box)
	var see: Array = a.get("see", [])
	_see_cap.visible = not see.is_empty()
	for l: String in see:
		if not _index.has(l):
			continue
		var lid := l
		var b := UITheme.small(title_of(l), func() -> void: open(lid), sec_title(str(_index[l]["sec"])))
		_see_box.add_child(b)
	var i := _order.find(id)
	_prev_b.disabled = i <= 0
	_next_b.disabled = i >= _order.size() - 1
	_mark_list()


func _step(d: int) -> void:
	var i := clampi(_order.find(cur) + d, 0, _order.size() - 1)
	open(_order[i])


## Левый столбец: все разделы; открытый раскрыт. При поиске — только найденные статьи по разделам.
func _fill_list() -> void:
	UITheme.clear(_list)
	var q := _search.text.strip_edges() if _search else ""
	if q != "":
		var found := search(q)
		_count_l.text = L.t("Найдено: %d") % found.size()
		if found.is_empty():
			var e := UITheme.para("Ничего не найдено. Попробуйте другое слово: «ток», «зарплата», «склад».", 13, UITheme.MUTED)
			_list.add_child(e)
			return
		var last_sec := ""
		for id in found:
			var a: Dictionary = _index[id]
			if str(a["sec"]) != last_sec:
				last_sec = str(a["sec"])
				var cap := UITheme.caption(sec_title(last_sec), UITheme.DIM)
				_list.add_child(cap)
			_list.add_child(_art_button(id))
		_mark_list()
		return
	_count_l.text = L.t("%d разделов · %d статей") % [SECTIONS.size(), _order.size()]
	for s: Dictionary in SECTIONS:
		var sid := str(s["id"])
		var is_open := sid == open_sec
		var sb := Button.new()
		sb.text = "%s  (%d)" % [sec_title(sid), (s["arts"] as Array).filter(func(a0: Dictionary) -> bool: return not hidden_art(str(a0["id"]))).size()]
		sb.icon = Tex.ui(str(s["icon"]))
		sb.expand_icon = false
		sb.add_theme_constant_override("icon_max_width", 22 if Tex.is_color(sb.icon) else 20)
		UITheme.icon_colors(sb)
		sb.alignment = HORIZONTAL_ALIGNMENT_LEFT
		sb.focus_mode = Control.FOCUS_NONE
		sb.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
		sb.clip_text = true
		sb.add_theme_font_size_override("font_size", 14)
		if UITheme.f_semi:
			sb.add_theme_font_override("font", UITheme.f_semi)
		var n := UITheme.sb(UITheme.BG3 if is_open else Color(0, 0, 0, 0), Color(0, 0, 0, 0), 0, 7, 8, 5)
		sb.add_theme_stylebox_override("normal", n)
		sb.add_theme_stylebox_override("hover", UITheme.sb(UITheme.BG4, Color(0, 0, 0, 0), 0, 7, 8, 5))
		sb.add_theme_stylebox_override("pressed", n)
		sb.add_theme_color_override("font_color", UITheme.TEXT if is_open else UITheme.MUTED)
		sb.add_theme_color_override("font_hover_color", UITheme.TEXT)
		sb.pressed.connect(func() -> void:
			if open_sec == sid:
				open_sec = ""
				_fill_list()
			else:
				open(str((s["arts"] as Array)[0]["id"])))
		_list.add_child(sb)
		if is_open:
			for a: Dictionary in s["arts"]:
				if not hidden_art(str(a["id"])):
					_list.add_child(_art_button(str(a["id"])))
			var gap := Control.new()
			gap.custom_minimum_size = Vector2(0, 4)
			_list.add_child(gap)
	_mark_list()


func _art_button(id: String) -> Button:
	var b := Button.new()
	b.text = title_of(id)
	b.alignment = HORIZONTAL_ALIGNMENT_LEFT
	b.focus_mode = Control.FOCUS_NONE
	b.text_overrun_behavior = TextServer.OVERRUN_TRIM_ELLIPSIS
	b.clip_text = true
	b.tooltip_text = title_of(id)
	b.add_theme_font_size_override("font_size", 13)
	b.set_meta("art", id)
	b.pressed.connect(func() -> void: open(id))
	return b


## Подсветить открытую статью в списке.
func _mark_list() -> void:
	if _list == null:
		return
	var e := UITheme.sb(Color(0, 0, 0, 0), Color(0, 0, 0, 0), 0, 6, 26, 4)
	var hv := UITheme.sb(Color(1, 1, 1, 0.06), Color(0, 0, 0, 0), 0, 6, 26, 4)
	var on := UITheme.sb(Color(UITheme.ACCENT.r, UITheme.ACCENT.g, UITheme.ACCENT.b, 0.16), Color(0, 0, 0, 0), 0, 6, 26, 4)
	on.border_width_left = 3
	on.border_color = UITheme.ACCENT
	for c in _list.get_children():
		var b := c as Button
		if b == null or not b.has_meta("art"):
			continue
		var sel := str(b.get_meta("art")) == cur
		b.add_theme_stylebox_override("normal", on if sel else e)
		b.add_theme_stylebox_override("hover", on if sel else hv)
		b.add_theme_stylebox_override("pressed", on)
		b.add_theme_color_override("font_color", UITheme.ACCENT if sel else UITheme.TEXT)
		b.add_theme_color_override("font_hover_color", UITheme.ACCENT if sel else Color.WHITE)
